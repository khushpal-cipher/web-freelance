# Local/production Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/intake_engine?schema=public"

# Used to HMAC-sign expiring signature-image URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET="change-me"

# Optional — leave blank to fall back to console-logged "sent" emails in the demo.
# Get a free key at https://resend.com after verifying a sending domain (or use
# their onboarding@resend.dev sandbox sender for testing).
RESEND_API_KEY=""
EMAIL_FROM="IntakeEngine <onboarding@resend.dev>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
